{
  "Authentication": {
    "Jwt": {
      "Issuer": "vm-acme",
      "Audience": "vm-acme-api",
      "ExpirationMinutes": 60
    }
  },
  "Persistence": {
    "Provider": "InMemory"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
